{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim",
    "@datadog/opencode-plugin"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--headless"
      ]
    },
    "vanta": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@vantasdk/vanta-mcp-server"
      ],
      "environment": {
        "VANTA_ENV_FILE": "/home/dev/vanta.env"
      },
      "enabled": true
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.eu-central-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=eu-west-1"
      ],
      "enabled": true,
      "environment": {
        "AWS_PROFILE": "sandbox"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
